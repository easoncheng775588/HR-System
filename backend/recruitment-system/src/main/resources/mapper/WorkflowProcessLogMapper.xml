<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hr.mapper.WorkflowProcessLogMapper">

    <resultMap id="WorkflowProcessLogMap" type="com.hr.entity.WorkflowProcessLog">
        <id property="logId" column="log_id"/>
        <result property="processCode" column="process_code"/>
        <result property="businessId" column="business_id"/>
        <result property="nodeOrder" column="node_order"/>
        <result property="nodeName" column="node_name"/>
        <result property="actionType" column="action_type"/>
        <result property="actionResult" column="action_result"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="operatorRole" column="operator_role"/>
        <result property="actionComment" column="action_comment"/>
        <result property="actionTime" column="action_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.hr.entity.WorkflowProcessLog" useGeneratedKeys="true" keyProperty="logId">
        INSERT INTO wf_process_log (
            process_code,
            business_id,
            node_order,
            node_name,
            action_type,
            action_result,
            operator_id,
            operator_name,
            operator_role,
            action_comment,
            action_time
        ) VALUES (
            #{processCode},
            #{businessId},
            #{nodeOrder},
            #{nodeName},
            #{actionType},
            #{actionResult},
            #{operatorId},
            #{operatorName},
            #{operatorRole},
            #{actionComment},
            #{actionTime}
        )
    </insert>

    <select id="selectByBusinessId" resultMap="WorkflowProcessLogMap">
        SELECT *
        FROM wf_process_log
        WHERE process_code = #{processCode}
          AND business_id = #{businessId}
        ORDER BY action_time DESC, log_id DESC
    </select>

</mapper>
